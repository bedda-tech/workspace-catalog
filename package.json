{
  "name": "@bedda/workspace-catalog",
  "version": "0.12.0",
  "description": "One component registry for the generative workspace: Nozio pages and Familiar chat render the same spec from this catalog.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedda-tech/workspace-catalog.git"
  },
  "peerDependencies": {
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@json-render/shadcn": "^0.19.0",
    "zod": "^4.0.0",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@json-render/shadcn": "^0.19.0",
    "typescript": "^5.9.0",
    "zod": "^4.4.3",
    "react": "^19.0.0",
    "@types/react": "^19.0.0"
  }
}
